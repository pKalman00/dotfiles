@import "colors.rasi"

configuration {
    modi:                   "drun,cliphist:~/.config/rofi/cliphist.sh,powermenu:~/.config/rofi/powermenu.sh";
    show-icons:             true;
    display-drun:           "";
    display-run:            "";
    display-filebrowser:    "";
    display-window:         "";
    display-powermenu:      "";
    display-cliphist:       "";
    drun-display-format:    "{name}";
    window-format:          "{w} · {c} · {t}";
    font:                   "JetBrains Mono Bold 12";
}
window {
    width:              30%;
    padding:            10px;
    fullscreen:         false;
    border:             3px solid;
    border-radius:      10px;
    border-color:       @accent;
    background-color:   @bg;   
}

mainbox {
    background-color:   transparent;
    spacing:            5px;
    border-radius:      10px;
    children:           [ "inputbar", "mode-switcher", "message", "listview" ];
}

message {
    padding:            10px;
    background-color:   @surface;
    border-radius:      10px;
}

textbox {
    background-color:   transparent;
    text-color:         @text;
    border-radius:      10px;
}

inputbar {
    background-color:   transparent;
    spacing:            0;
    padding:            8px 10px;
    border-radius:      10px;
    children:           [ prompt, entry, case-indicator ];
}

prompt {
    background-color:   transparent;
    text-color:         @accent;
    padding:            0 10px;
    border-radius:      10px;
}

entry {
    background-color:   transparent;
    text-color:         @text;
    placeholder-color:  @text-dim;
    padding:            0 6px;
    border-radius:      10px;
}

case-indicator {
    background-color:   transparent;
    text-color:         @text-dim;
    padding:            6px 10px;
    border-radius:      10px;
}

listview {
    background-color:   transparent;
    border-radius:      10px;
    fixed-height:       false;
    dynamic:            true;
    scrollbar:          false;
    spacing:            2px;
    padding:            5px 0 0 0;
    margin:             4px 4px 4px 4px;
}

/* ── Element base ───────────────────────────────────────── */
element {
    border-radius:      10px;
    padding:            3px 5px;
    background-color:   @surface;
    text-color:         @text;
}

element normal.normal, element alternate.normal {
    background-color:   @surface;
    text-color:         @text;
}

element selected.normal {
    background-color:   @accent;
    text-color:         @bg;
}

element normal.urgent, element alternate.urgent {
    background-color:   @surface;
    text-color:         @urgent;
}

element selected.urgent {
    background-color:   @urgent;
    text-color:         @bg;
}


/* ── Mode switcher ──────────────────────────────────────── */
mode-switcher {
    background-color:   @surface;
    border-radius:      20px;
}

button {
    background-color:   @surface;
    text-color:         @text;
    border-radius:      20px;
}

button selected {
    background-color:   @accent;
    text-color:         @bg;
    border-radius:      20px;
}
