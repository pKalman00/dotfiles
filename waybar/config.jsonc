{
  "layer": "top",
  "position": "top",
  // "height": 38,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "ipc": true,
  "reload_style_on_change": true,
  "gtk-layer-shell": true,

  "modules-left": [
    "hyprland/workspaces",
    "backlight",
    "network",
    "bluetooth",
  ],

  "modules-center": [
    "clock",
  ],

  "modules-right": [
    "tray",
    // "custom/player",
    "wireplumber",
    "wireplumber#source",
    "battery"
  ],

  // ─────────────────────────────
  // WORKSPACES
  // ─────────────────────────────
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
    // "active-only": false,
    // "all-outputs": true,
    // "show-special": true,
    // "on-scroll-up": "hyprctl dispatch workspace e-1",
    // "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  // ─────────────────────────────
  // CLOCK
  // ─────────────────────────────
  "clock": {
    "interval": 60,
    "format": "{:%H:%M - %b %d}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "first-day": 1,
      "format": {
        "months":   "<span color='#e6e1cf'><b>{}</b></span>",
        "days":     "<span color='#cad3f5'><b>{}</b></span>",
        "weekdays": "<span color='#ff3333'><b>{}</b></span>",
        "today":    "<span color='#f5a97f'><b><u>{}</u></b></span>"
      }
    }
  },

  // ─────────────────────────────
  // NETWORK
  // ─────────────────────────────
  "network": {
    "interval": 5,
    "format-wifi":        "  {essid} {bandwidthDownBytes}",
    "format-ethernet":    "󰈀  wired",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{signalStrength}%",
    "on-click": "nm-connection-editor"
  },

  // ─────────────────────────────
  // MEMORY
  // ─────────────────────────────
  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G used / {total:0.1f}G total\n{percentage}% utilized"
  },

  // ─────────────────────────────
  // BLUETOOTH
  // ─────────────────────────────
  "bluetooth": {
    "format":           "󰂯",
    "format-disabled":  "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{device_alias}\n{controller_alias}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth",
  },

  // ─────────────────────────────
  // AUDIO OUTPUT
  // ─────────────────────────────
  "wireplumber": {
    "format":       "{icon} {volume}%",
    "format-muted": "",
    "tooltip": false,
    "scroll-step": 5,
    "max-volume": 100,
    "reverse-scrolling": true,
    "on-click":        "wpctl set-mute @DEFAULT_SINK@ toggle",
    // "on-scroll-up":    "wpctl set-volume @DEFAULT_SINK@ 5%+",
    // "on-scroll-down":  "wpctl set-volume @DEFAULT_SINK@ 5%-",
    "format-icons": {
      "headphone":  "󰋋",
      "hands-free": "󰋎",
      "headset":    "󰋎",
      "phone":      "󰏲",
      "portable":   "󰏲",
      "car":        "󰄋",
      // "default":    ["󰕿", "󰖀", "󰕾"]
      "default":    ["", "", ""]
    }
  },

  // ─────────────────────────────
  // MICROPHONE
  // ─────────────────────────────
  "wireplumber#source": {
    "node-type": "Audio/Source",
    // "format":              "{format_source}",
    "format":       "󰍬 {volume}%",
    "format-muted": "󰍭",
    "tooltip": false,
    "scroll-step": 5,
    "max-volume": 100,
    "reverse-scrolling": true,
    "on-click":        "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    // "on-scroll-up":    "wpctl set-volume @DEFAULT_SOURCE@ 5%+",
    // "on-scroll-down":  "wpctl set-volume @DEFAULT_SOURCE@ 5%-"
  },

  // ─────────────────────────────
  // BATTERY
  // ─────────────────────────────
  "battery": {
    "interval": 60,
    "states": {
      "good":     80,
      "warning":  30,
      "critical": 20
    },
    "format":          "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged":  "󰚥 {capacity}%",
    "format-full":     "󰁹 {capacity}%",
    "tooltip-format":  "{timeTo}",
    "format-icons": [
      "󰂎","󰁺","󰁻","󰁼","󰁽",
      "󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"
    ]
  },

  // ─────────────────────────────
  // BACKLIGHT
  // ─────────────────────────────
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
  },

  // ─────────────────────────────
  // UPDATES
  // ─────────────────────────────
  "custom/updates": {
    "format":      "{}",
    "tooltip":     true,
    "interval":    600,
    "return-type": "json",
    "exec":        "$HOME/.config/waybar/bin/updatecheck"
  },

  // ─────────────────────────────
  // TRAY
  // ─────────────────────────────
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },

  // ------------------------------
  // PLAYER
  // ------------------------------
  "custom/player": {
    "format": "󰎆 {}",
    "interval": 5,
    "exec": "$HOME/.config/waybar/bin/playerinfo",
    "max-length": 40,
    "tooltip": true,
  },
}
