# Style
font=JetBrainsMono SemiBold 10
width=350
border-radius=10
border-size=2
padding=7
margin=3,3,10
icon-border-radius=3

# Colors
background-color=#0a0e1a
text-color=#e0e6f0
border-color=#4a9eff

# Misc
format=<i>%a</i>\n<b>%s</b>\n%b
default-timeout=8000

[grouped]
format=(%g) <i>%a</i>\n<b>%s</b>\n%b

[urgency=critical]
text-color=#ff5555
border-color=#ff5555
default-timeout=0

[mode=do-not-disturb]
invisible=1
